[A: _Inter] testFunc :: something: A -> bool:
	return false;

struct MyStruct {
	someField: int,
	otherField: char,
}

may MyStruct | testPipe :::
	return if testFunc $ self:
		yield say $ "who knows";


main :: -> int:
	new myStruct = MyStruct <<
		someField: 7,
		otherField: 'a' >>;
	myStruct | testPipe;
	return 0;

